{
  "manifest_version": 3,
  "name": "LavorAI Candidate Autofill (pilot)",
  "version": "0.2.0",
  "description": "User-reviewed contact autofill. Never submits applications.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open reviewed autofill"
    }
  }
}
