# --- Sprint 2: pipeline AI ---
# Provider primario auto-apply (Responses API, store=false)
OPENAI_API_KEY=
OPENAI_MODEL_STRONG=gpt-5.6-terra
OPENAI_MODEL_FAST=gpt-5.6-luna

# Fallback opzionale: usato solo se OpenAI ha un errore transitorio/quota
ANTHROPIC_API_KEY=
RESEND_API_KEY=
RESEND_RECEIVING_API_KEY=
RESEND_FROM_OVERRIDE=

# --- Sprint 4: auto-apply ---

# Adzuna Jobs API — https://developer.adzuna.com (registrazione gratis)
# Senza queste chiavi, il feed /jobs usa 10 job mock per sviluppo.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Chiave di cifratura per session cookie dei portali terzi.
# ALMENO 32 caratteri, random. Genera con: openssl rand -hex 32
# In produzione: metti su Vercel env + ruota annualmente.
APP_ENCRYPTION_KEY=

# Prisma — SQLite locale (default). Per prod: Supabase Frankfurt postgresql
DATABASE_URL="file:./dev.db"
# Required for Postgres (pooled connection for migrations)
# In dev with SQLite, set to same as DATABASE_URL
DIRECT_URL="file:./dev.db"

# --- Google OAuth + Gmail (sprint 6) ---
# Google Cloud Console → APIs & Services → Credentials
# OAuth 2.0 Client ID (Web application)
# Scopes: openid, email, profile, gmail.readonly
# Redirect URI: https://lavorai.it/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe (sprint 5) ---
STRIPE_SECRET_KEY=
STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_XXX
STRIPE_WEBHOOK_SECRET=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_XXX

# Scheduled/batch USER notifications (onboarding, upgrade, weekly digest,
# trial day_3/day_6/ended, checkout recovery + admin checkout-feedback).
# The same fail-closed hold also stops automatic recruiter-reply forwarding
# and per-user inbox notices. Held items stay stored/visible and are marked
# notifyStatus=held so they are not auto-sent when HOLD is later removed.
# Fail-closed: unset or invalid USER_NOTIFICATIONS_NOT_BEFORE holds them
# the same as HOLD=true. Auth emails (verify, password reset, welcome,
# magic link) are not affected. Cutoff is a configured instant — never
# derived from a successful send. Sequence:
#   (a) Before activating Resend keys: HOLD=true and
#       NOT_BEFORE=<ISO-8601 with offset of the activation instant>
#   (b) After receiving-check + owned test send validate: delete HOLD,
#       keep NOT_BEFORE. Existing users stay eligible for later weeks
#       and new events; pre-cutoff due stages are not replayed.
# USER_NOTIFICATIONS_HOLD=true
# USER_NOTIFICATIONS_NOT_BEFORE=2026-10-25T18:00:00+02:00
USER_NOTIFICATIONS_HOLD=
USER_NOTIFICATIONS_NOT_BEFORE=

# Separate merge from activation. After deploy, newly eligible rows stay held
# until this gate allows them. Default off. Historical replay stays disabled.
# APPLICATION_RECOVERY_RELEASE=off
# APPLICATION_RECOVERY_RELEASE_IDS=
# APPLICATION_RECOVERY_RELEASE_CAP=3
# Recruiter-email fallback for skip-list hosts (Ashby). Default false: a found
# address may be recorded but is never queued. When on, only a posting-specific
# published inbox is accepted.
# RECRUITER_EMAIL_FALLBACK_ENABLED=false

# Recruiter-email delivery (no production env change required).
# Resend can send only from lavorai.it. inbound.lavorai.it and apply.lavorai.it
# are receive-only. From is '"<Full Name> via LavorAI" <candidature@lavorai.it>'.
# RECRUITER_EMAIL_FROM=candidature@lavorai.it
# Reply-To for applications: reply+<applicationId>@inbound.lavorai.it
# Greenhouse OTP and ATS receipts use this reply+ alias. Required for the
# proven-channel Greenhouse path.
# INBOUND_EMAIL_DOMAIN=inbound.lavorai.it
# Proven-channel pilot: restrict auto-apply to Greenhouse forms we can
# answer truthfully + published employer-domain recruiter emails.
# off = nobody restricted; pilot = allow-list only (default); all = everyone.
# Empty allow-list means nobody is restricted. Owner pilot user id example:
# PROVEN_CHANNEL_MODE=pilot
# PROVEN_CHANNEL_PILOT_USER_IDS=cmo9z6ueg0000ie042ksa0i31
# Per-user inbound mailbox domain (receive-only, default apply.lavorai.it):
# INBOUND_USER_DOMAIN=apply.lavorai.it
# Optional AI fallback for leftover "other" mailbox mail (low temperature).
# Never marks rejection. Tests must not enable this.
# INBOUND_AI_CLASSIFY=false
# Optional daily cap of recruiter emails per recipient domain (default 12).
# RECIPIENT_DOMAIN_DAILY_LIMIT=12

# Controlled email test (admin POST /api/admin/email-test-send). Works while
# APPLICATIONS_PAUSED=true. No gate env. Never reuses the 14/10 canary key.
# Destination must be the inbound canary alias or delivered@ / bounced@ /
# complained@resend.dev. EMAIL_TEST_USER_ID is the dedicated test user's
# Prisma User.id (ATS_TEST_USER_ID is accepted as a fallback).
# EMAIL_TEST_USER_ID=

# Restricted ATS test (admin only). Dedicated user + allowlisted destination.
# Do not add the tenant to RECRUITEE_COMPANIES. Real submit default off.
# One application row per destination: use two offers for dry vs real.
# ATS_TEST_USER_ID=
# ATS_TEST_DESTINATIONS=produzioneweb.recruitee.com/o/<dry-offer>,produzioneweb.recruitee.com/o/<real-offer>
# ATS_TEST_REAL_SUBMIT=false

