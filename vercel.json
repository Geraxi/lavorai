{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/cron/nudges",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/sync-jobs",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/editorial",
      "schedule": "0 8 * * 1-5"
    }
  ]
}
