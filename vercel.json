{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/cron/nudges",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/sync-jobs",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/description-backfill",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/editorial",
      "schedule": "0 8 * * 1-5"
    },
    {
      "path": "/api/cron/mailbox-delivery",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/drain-queue",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/auto-apply",
      "schedule": "0 8,9,12,13,16,17 * * *"
    },
    {
      "path": "/api/cron/mailbox-digest",
      "schedule": "15 10 * * *"
    },
    {
      "path": "/api/cron/mailbox-retention",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/recruitee-catalogue",
      "schedule": "0 */4 * * *"
    }
  ]
}
