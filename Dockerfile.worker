# LavorAI worker — deployable su Railway / Render / Fly.
# Base image Playwright include Chromium + dipendenze OS → no install headache.

FROM mcr.microsoft.com/playwright:v1.59.1-jammy@sha256:8a0360d39d1973be506dd59002904a774f6d697d4946c94063b3fd006461c8ff AS base

# Official Node release; hashes verified against nodejs.org SHASUMS256.txt.
# Preserve Playwright browsers/OS libraries, replace the inherited Node runtime.
RUN set -eu; \
    apt-get update; \
    apt-get install -y --no-install-recommends xz-utils; \
    rm -rf /var/lib/apt/lists/*; \
    case "$(uname -m)" in \
      x86_64) arch=x64; checksum=6c172a9ab6718f7b801fb5a7bd486af2ee5e32758086a04b84fcce2aa77095e6 ;; \
      aarch64) arch=arm64; checksum=dbabf7a1cbf947e6059ffad2c27b80041db97dea1e553b62afdee7f13fca336e ;; \
      *) echo "Unsupported worker architecture" >&2; exit 1 ;; \
    esac; \
    archive="node-v24.22.1-linux-${arch}.tar.xz"; \
    curl --fail --silent --show-error --location "https://nodejs.org/dist/v24.22.1/${archive}" -o /tmp/node-worker.tar.xz; \
    echo "${checksum}  /tmp/node-worker.tar.xz" | sha256sum --check -; \
    tar -xJf /tmp/node-worker.tar.xz -C /usr/local --strip-components=1; \
    rm /tmp/node-worker.tar.xz; \
    test "$(node --version)" = "v24.22.1"
ENV PATH="/usr/local/bin:${PATH}"
WORKDIR /app

# Solo le deps necessarie al worker (no dev deps)
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# Prisma schema + generate client
COPY prisma ./prisma
RUN npx prisma generate

# Installiamo tsx per runnare TypeScript direttamente (no build step)
RUN npm install --no-save tsx

# Codice sorgente (solo quello che serve al worker)
COPY src ./src
COPY worker.ts ./
COPY tsconfig.json ./

# Node env
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Health check: worker deve tenere connessione Redis viva
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD node -e "require('ioredis').prototype.ping || process.exit(0)" || exit 1

CMD ["npx", "tsx", "worker.ts"]
