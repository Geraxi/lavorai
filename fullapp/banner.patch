diff --git a/src/app/globals.css b/src/app/globals.css
index c7c8bb2..eea79a8 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -1803,3 +1803,77 @@ a.gd-chip:hover { border-color: hsl(var(--primary) / 0.6); }
   .mat-detail-tabs[role="tablist"]::-webkit-scrollbar { display: none; }
   .reference-workspace .mat-detail-tabs[role="tablist"] button, .mat-detail-tabs[role="tablist"] button { flex-shrink: 0; min-height: 44px; }
 }
+
+/* ── Service Notice Banner ──────────────────────────────────────────────
+   Temporary site-wide notice shown above all content. Amber/yellow alert
+   style that works in both dark and light themes. Non-dismissible. */
+.service-notice-banner {
+  width: 100%;
+  background: linear-gradient(135deg, rgba(251, 191, 36, 0.12) 0%, rgba(245, 158, 11, 0.12) 100%);
+  border-bottom: 1px solid rgba(251, 191, 36, 0.2);
+  padding: 12px 16px;
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  position: relative;
+  z-index: 999;
+}
+
+.service-notice-content {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  max-width: 1200px;
+  width: 100%;
+}
+
+.service-notice-icon {
+  flex-shrink: 0;
+  color: rgb(251, 191, 36);
+}
+
+.service-notice-text {
+  font-size: 14px;
+  line-height: 1.5;
+  color: var(--fg);
+  margin: 0;
+}
+
+.service-notice-text strong {
+  font-weight: 600;
+  color: rgb(251, 191, 36);
+}
+
+/* Light theme adjustments */
+[data-theme="light"] .service-notice-banner {
+  background: linear-gradient(135deg, rgba(251, 191, 36, 0.15) 0%, rgba(245, 158, 11, 0.15) 100%);
+  border-bottom-color: rgba(217, 119, 6, 0.25);
+}
+
+[data-theme="light"] .service-notice-icon {
+  color: rgb(217, 119, 6);
+}
+
+[data-theme="light"] .service-notice-text strong {
+  color: rgb(217, 119, 6);
+}
+
+/* Mobile responsive */
+@media (max-width: 640px) {
+  .service-notice-banner {
+    padding: 10px 16px;
+  }
+  
+  .service-notice-content {
+    gap: 10px;
+  }
+  
+  .service-notice-icon {
+    width: 16px;
+    height: 16px;
+  }
+  
+  .service-notice-text {
+    font-size: 13px;
+  }
+}
