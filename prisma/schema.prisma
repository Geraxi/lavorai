// LavorAI — production PostgreSQL schema.
// Apply reviewed additive migrations only. This repository previously had no
// migration baseline; see prisma/migrations/README.md before deploying.
// Never reset a populated production database to initialize migration history.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Provider postgresql per produzione (Vercel Postgres / Supabase / Neon).
  // Vercel Postgres best practice:
  //   DATABASE_URL → POSTGRES_PRISMA_URL (pooled, per runtime queries)
  //   DIRECT_URL   → POSTGRES_URL_NON_POOLING (diretta, per migrations/db push)
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- NextAuth tables (@auth/prisma-adapter) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Token one-time per verificare l'email post-signup password.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique  // sha256 hex
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Token one-time per il reset password. Separato da VerificationToken
/// (che NextAuth riserva al magic link) per evitare collisioni.
model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique  // sha256 hex
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------- Business tables ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())

  // Subscription (one-to-one con Stripe)
  tier                   String    @default("free") // "free" | "pro" | "pro_plus"
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  subscriptionStatus     String?   // "active" | "canceled" | "past_due" | "paused" | null
  currentPeriodEnd       DateTime?
  /// Cancellazione richiesta dall'utente: il piano resta attivo fino a currentPeriodEnd.
  cancelAtPeriodEnd      Boolean   @default(false)
  /// Abbonamento in pausa (Stripe pause_collection) fino a questa data.
  pausedUntil            DateTime?
  subscriptionEvents     SubscriptionEvent[]

  /// Sospeso dall'admin: login bloccato, escluso dall'auto-apply.
  suspendedAt      DateTime?
  /// Prova Pro 7 giorni già usata (una sola per utente).
  proTrialUsedAt   DateTime?
  /// Prova Pro senza carta: fino a questa data l'utente Free è trattato come Pro.
  trialEndsAt      DateTime?
  /// Legacy cohort marker only; billing.ts fixes the final early-user deadline. No rolling grace.
  trialGraceEndsAt DateTime?
  /// Durata della prova dalla creazione dell’account (7 giorni).
  trialDurationDays Int      @default(7)
  /// Mesi gratis maturati dal referral, da applicare al prossimo checkout.
  referralCredits  Int       @default(0)
  /// Il referral è già stato premiato (per questo utente "invitato").
  referralRewardedAt DateTime?
  /// "Come ci hai conosciuto" dichiarato al signup.
  signupSource     String?
  /// "Reset crediti" admin: il contatore mensile riparte da questa data.
  quotaResetAt     DateTime?

  // Onboarding / lifecycle
  welcomeSeenAt    DateTime?
  /// Anteprima gratuita CV + lettera generata nel percorso di attivazione.
  /// Serve a far vedere valore prima di chiedere il metodo di pagamento.
  demoGeneratedAt  DateTime?
  demoCompletedAt  DateTime?
  onboardedAt      DateTime?
  lastLoginAt      DateTime?
  privacyConsentAt DateTime?

  // Dati per auto-apply targeting
  seniority        String?  // "junior" | "mid" | "senior" | "lead" | "principal"
  yearsExperience  Int?
  englishLevel     String?  // "none" | "a2" | "b1" | "b2" | "c1" | "c2"
  italianNative    Boolean  @default(true)
  euAuthorized     Boolean  @default(true)
  noticePeriod     String?  // "immediate" | "1m" | "2m" | "3m_plus"
  avoidCompanies   String?  // comma-separated lowercase

  // UI language preference. "it" o "en". Settato al primo signup dal
  // cookie NEXT_LOCALE (impostato dal proxy geo-detect). Usato per:
  //  - Email transazionali (verifica, CV pronto, conferma candidatura)
  //  - Eventuale routing futuro nelle preferenze
  locale           String   @default("it")

  accounts       Account[]
  sessions       Session[]
  portalSessions PortalSession[]
  applications   Application[]
  cvDocuments    CVDocument[]
  preferences         UserPreferences?
  cvProfile           CVProfile?
  applicationSessions ApplicationSession[]
  interviewSessions   InterviewSession[]
  resetTokens    PasswordResetToken[]
  verifyTokens   EmailVerificationToken[]
  popupResponses PopupResponse[]
  feedbackReports FeedbackReport[]
  feedbackUploadBudget FeedbackUploadBudget?
  answers        UserAnswer[]
  conversionEvents ConversionEvent[]
  gmailMessages  GmailMessage[]
  jobDismissals  JobDismissal[]
  mailboxConnections MailboxConnection[]
  userInbox      UserInbox?
  inboundEmails  InboundEmail[]

  // Referral: ogni utente ha un codice univoco da condividere; referredById
  // punta a chi l'ha invitato (se applicabile). Reward gestito a parte
  // (es. mese gratis Pro per entrambi quando il referred upgrada).
  referralCode  String?           @unique
  referredById  String?
  referredBy    User?             @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     User[]            @relation("UserReferrals")

  // Attribution first-touch: da dove è arrivato l'utente al signup.
  // Popolati dal signup route leggendo cookie `lv_attrib` scritto da
  // <TrackAttribution/> alla prima pageview (persiste 30gg, non
  // sovrascritto — first-touch, non last-touch).
  signupReferrer     String? // dominio del referrer (es. "google.com", "producthunt.com", "direct")
  signupUtmSource    String? // valore ?utm_source
  signupUtmMedium    String? // valore ?utm_medium
  signupUtmCampaign  String? // valore ?utm_campaign
  signupLandingPath  String? // primo path visitato (es. "/auto-candidatura")

  // One-shot Meta CompleteRegistration (relation only; no column on User).
  registrationConversion RegistrationConversion?
}

/// Append-only cookie/advertising consent evidence. Never updated or deleted
/// by the app: a withdrawal inserts a new row. visitorId is an opaque random
/// browser reference, not linked to User. noticeVersion maps to the exact
/// text/purposes/recipients in src/lib/consent/notice.ts.
model ConsentRecord {
  id              String   @id @default(cuid())
  visitorId       String
  noticeVersion   String
  region          String // ISO 3166-1 alpha-2 or "unknown"
  consentRequired Boolean
  analytics       String // "granted" | "denied"
  advertising     String // "granted" | "denied"
  action          String // "accept_all" | "reject_all" | "save_preferences" | "withdraw"
  source          String // "banner" | "settings"
  createdAt       DateTime @default(now())

  @@index([visitorId, createdAt])
}

/// One row per brand-new account, created at account creation. eventId is the
/// opaque Meta eventID; claimedAt makes the browser-side event one-shot.
model RegistrationConversion {
  id        String    @id @default(cuid())
  userId    String    @unique
  eventId   String    @unique
  method    String // "password" | "google" | "magic_link"
  createdAt DateTime  @default(now())
  claimedAt DateTime?
  outcome   String? // "released" | "blocked_no_consent" | "expired"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Pipeline editoriale SEO. Le bozze generate dall'AI non diventano mai
/// pubbliche senza un'azione esplicita dell'admin.
model EditorialArticle {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  metaTitle   String
  description String
  keyword     String
  category    String
  status      String   @default("review") // review | published | archived
  content     Json
  faq         Json
  keywords    Json
  scheduledFor DateTime?
  generatedAt DateTime @default(now())
  publishedAt DateTime?
  updatedAt   DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([scheduledFor])
}

/// Page-view tracking leggero per le metriche admin. Non sostituisce
/// un'analytics seria (es. Vercel Analytics): è pensato come dato grezzo
/// di cui abbiamo il controllo, mostrato nel pannello /admin.
model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  /// userId loggato (se la pagina è autenticata), null per anonimi.
  userId    String?
  /// session id (cookie lato client) — per stimare visitatori unici.
  sessionId String?
  /// Country dal geo header Vercel (best-effort).
  country   String?
  /// Suddivisione (regione/provincia) e città dai geo header Vercel
  /// (x-vercel-ip-country-region, x-vercel-ip-city). Best-effort.
  region    String?
  city      String?
  /// User agent troncato.
  userAgent String?
  ts        DateTime @default(now())

  @@index([ts])
  @@index([path, ts])
  @@index([sessionId])
}

/// Eventi first-party del funnel commerciale. Il payload è volutamente
/// minimale: nessun CV, risposta o dato sensibile viene salvato qui.
model ConversionEvent {
  id             String   @id @default(cuid())
  name           String
  userId         String?
  sessionId      String?
  path           String?
  plan           String?
  source         String?
  valueCents     Int?
  propertiesJson String?  @db.Text
  dedupeKey      String?  @unique
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
}

/// Ultimo segnale reale per ciascun provider AI. Evita di dedurre lo stato
/// corrente da vecchi errori di candidatura appartenenti ad altri provider.
model AiHealthState {
  id        String   @id
  status    String
  model     String?
  source    String?
  message   String?  @db.Text
  latencyMs Int?
  checkedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Risposte RIUTILIZZABILI dell'utente alle domande dei form di candidatura
/// (es. "Hai diritto al lavoro in UK?", "Hai esperienza con app mobile?",
/// "Link al portfolio"). Chieste UNA volta: la prossima volta che un form
/// pone la stessa domanda, la riempiamo da qui senza ridisturbare l'utente.
/// labelKey = label normalizzata (lowercase, no spazi/punteggiatura) per il
/// match cross-job.
model UserAnswer {
  id         String   @id @default(cuid())
  userId     String
  /// Chiave normalizzata della domanda (per match tra job diversi).
  labelKey   String
  /// Testo originale della domanda (per mostrarla all'utente).
  label      String
  /// "text" | "textarea" | "select" | "react-select" | "checkbox"
  kind       String   @default("text")
  /// Opzioni disponibili (per select/react-select), JSON array di stringhe.
  optionsJson String? @db.Text
  /// Risposta dell'utente. null/"" = ancora da rispondere (pending).
  answer     String?  @db.Text
  /// Chi ha risposto: "user" (in /questions) | "ai" | "rule" (auto-apply autonomo).
  source     String   @default("user")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  answeredAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, labelKey])
  @@index([userId, answeredAt])
}

/// Popup/sondaggio creato dall'admin (founder) e mostrato agli utenti
/// dentro l'app. Es: "Ti piace la piattaforma?", richieste di feedback,
/// proposte di miglioramento. Gestiti da /admin.
model AdminPopup {
  id        String  @id @default(cuid())
  title     String
  body      String  @db.Text
  /// Tipo di interazione richiesta:
  ///   "rating"      = stelline 1-5 (+ commento opzionale)
  ///   "feedback"    = campo testo libero
  ///   "improvement" = proposta di miglioramento (campo testo)
  ///   "info"        = solo messaggio, bottone di conferma (nessun input)
  kind      String  @default("feedback")
  /// Etichetta del bottone di invio/conferma. Default per-kind se vuoto.
  ctaLabel  String?
  /// Pubblico target: "all" | "free" | "pro" | "pro_plus".
  audience  String  @default("all")
  /// Solo i popup attivi vengono mostrati. Disattivare = stop immediato.
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  /// Scadenza opzionale: dopo questa data non viene più mostrato.
  expiresAt DateTime?

  responses PopupResponse[]

  @@index([active])
}

/// Risposta (o dismiss) di un utente a un AdminPopup. Una per (popup,user):
/// così ogni utente vede il popup una volta sola, poi non più.
model PopupResponse {
  id        String  @id @default(cuid())
  popupId   String
  userId    String
  /// Valutazione 1-5 per i popup "rating". null altrimenti.
  rating    Int?
  /// Testo libero per "feedback"/"improvement" (o commento del rating).
  text      String? @db.Text
  /// true se l'utente ha chiuso senza rispondere ("Più tardi"/X).
  dismissed Boolean @default(false)
  createdAt DateTime @default(now())

  popup AdminPopup @relation(fields: [popupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([popupId, userId])
  @@index([popupId, createdAt])
}

/// User-initiated reports. Never stores automatic diagnostics or URLs.
model FeedbackReport {
  id          String   @id @default(cuid())
  userId      String
  category    String   @db.VarChar(16)
  subject     String   @db.VarChar(120)
  description String   @db.VarChar(4000)
  pageContext String?  @db.VarChar(32)
  locale      String   @db.VarChar(2)
  status      String   @default("new") @db.VarChar(16)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments FeedbackAttachment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt, id])
}

/// Fixed-window upload attempt budget, including invalid and failed uploads.
model FeedbackUploadBudget {
  userId    String @id
  hourStart DateTime
  hourCount Int
  dayStart  DateTime
  dayCount  Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Private, bounded support files. Never select data in report list/detail JSON.
model FeedbackAttachment {
  id          String @id @default(cuid())
  reportId    String
  position    Int
  filename    String @db.VarChar(120)
  contentType String @db.VarChar(32)
  byteLength  Int
  data        Bytes
  scanStatus  String @db.VarChar(16)
  createdAt   DateTime @default(now())
  report      FeedbackReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, position])
}

model UserPreferences {
  id          String @id @default(cuid())
  userId      String @unique
  // Deprecated legacy flag — autoApplyMode è l'autorità
  autoApplyOn Boolean @default(false)
  // "off" (nessuna candidatura), "hybrid" (richiede conferma utente per singola), "auto" (candida direttamente)
  autoApplyMode String @default("auto")
  dailyCap    Int    @default(10)
  matchMin    Int    @default(50)
  salaryMin   Int    @default(30)
  // "employee" | "piva" | "both" — filtra le candidature per tipo
  // contrattuale. "piva" = cerchiamo solo incarichi freelance /
  // contract / partnership (P.IVA italiana). "both" = sia dipendente
  // sia freelance.
  employmentType String @default("employee")
  /// L'utente appartiene alle categorie protette (L. 68/99, art. 1):
  /// il job board mostra e l'auto-apply privilegia gli annunci riservati.
  protectedCategory Boolean @default(false)
  // Campi P.IVA — usati per generare un pitch B2B quando si candida
  // a progetti freelance/contract. Tutti opzionali: se mancano, Claude
  // genera comunque un pitch onesto ma meno puntuale.
  dailyRate      Int?       // tariffa giornaliera in euro (es. 450)
  availableFrom  String?    // stringa libera: "immediate" | "2 settimane" | "2026-06-01"
  vatNumber      String?    // partita IVA (opzionale, per firma professionale)
  portfolioUrl   String?    // link portfolio / sito / LinkedIn
  // Risposte standard alle domande tipiche dei form ATS — il worker
  // legge questo blob e lo inietta nei custom field di Greenhouse/Lever
  // (work auth, salary, notice period, LinkedIn, EEO, ecc).
  // Schema atteso (vedi src/lib/application-answers.ts):
  //   { workAuthEU, salaryExpectationEur, relocate, linkedinUrl,
  //     githubUrl, howHeard, whyInterested, noticePeriod,
  //     eeoGender, eeoVeteran, eeoDisability }
  applicationAnswersJson String @default("{}")
  rolesJson   String @default("[]")
  locationsJson String @default("[]")
  sourcesJson String @default("[]")
  /// Mailbox notifications: "priority" (interview/questions now, rest in digest),
  /// "digest" (daily only), "off". Never auto-replies to employers.
  mailboxNotifyMode String @default("priority")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Structured CV profile — single source of truth for CV builder.
/// All sections are JSON blobs to keep schema small; shapes validated in code.
model CVProfile {
  id             String   @id @default(cuid())
  userId         String   @unique

  // Personal
  firstName      String   @default("")
  lastName       String   @default("")
  email          String   @default("")
  phone          String   @default("")
  city           String   @default("")
  title          String   @default("")   // professional headline
  summary        String   @default("") @db.Text

  // Sections (JSON array strings)
  experiencesJson String  @default("[]") @db.Text
  educationJson   String  @default("[]") @db.Text
  skillsJson      String  @default("[]") @db.Text
  languagesJson   String  @default("[]") @db.Text
  linksJson       String  @default("[]") @db.Text

  // Base CV PDF (not job-specific)
  pdfPath        String?
  pdfLanguage    String?  // "it" | "en" | null

  // Foto profilo CV (opzionale)
  photoPath      String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PortalSession {
  id               String    @id @default(cuid())
  userId           String
  portal           String
  encryptedCookies String
  userAgent        String
  lastValidatedAt  DateTime  @default(now())
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, portal])
}

model Job {
  id            String    @id @default(cuid())
  externalId    String
  source        String
  title         String
  company       String?
  location      String?
  description   String
  url           String
  contractType  String?
  remote        Boolean   @default(false)
  salaryMin     Int?
  salaryMax     Int?
  category      String?
  postedAt      DateTime?
  cachedAt      DateTime  @default(now())
  // Email del recruiter estratta scrapando il job.url. Null se non trovata.
  recruiterEmail String?
  recruiterScrapedAt DateTime?
  /// URL of the employer-published page/text where recruiterEmail was observed.
  /// Additive only — never guess jobs@domain; never mine unrelated pages.
  recruiterEmailSourceUrl String?
  /// Employer website published by the ATS/board (https host). Never guessed
  /// from a tenant slug. Used only to fetch careers/contact on that domain.
  companyWebsite String?
  // Slug dell'ATS (es. "stripe" per boards.greenhouse.io/stripe/...)
  // Usato per costruire l'URL canonico del form quando il job è linkato
  // da una career page custom (es. stripe.com/jobs?gh_jid=...)
  sourceSlug String?
  // Annuncio non più online (404/“Job not found”/redirect alla lista del board).
  // Settato dal worker (liveness check) o da sync-jobs quando il board non lo
  // restituisce più. Il cron auto-apply lo esclude; riaperto se ricompare.
  closedAt DateTime?
  /// Annuncio riservato/prioritario per le categorie protette (L. 68/99):
  /// riconosciuto da titolo/descrizione (src/lib/protected-category.ts).
  protectedCategory Boolean @default(false)
  /// Last successful full-description fetch from a public board API.
  /// Null rows at exactly 2,000 chars are eligible for the bounded backfill.
  descriptionFetchedAt DateTime?
  /// Failed public-board fetches increment this and set descriptionFetchRetryAt
  /// so the same 429/timeout rows do not occupy the candidate window forever.
  descriptionFetchAttempts Int?
  descriptionFetchRetryAt DateTime?

  applications Application[]
  dismissals JobDismissal[]

  @@unique([externalId, source])
  @@index([closedAt])
  @@index([protectedCategory, postedAt])
}

/// Cache of a published hiring inbox found on the employer's own domain.
/// Additive only. email is null when the last check found none (negative cache).
model EmployerHiringInbox {
  companyDomain String   @id
  email         String?
  sourceUrl     String?
  evidence      String?  @db.Text
  status        String
  checkedAt     DateTime
  updatedAt     DateTime @updatedAt
}

/// Cached Greenhouse boards-api questions snapshot (not candidate answers).
/// Additive only. Used by the proven-channel pre-check; never stores guessed answers.
model GreenhouseJobForm {
  cacheKey     String   @id
  boardToken   String
  jobId        String
  absoluteUrl  String?
  /// "native" | "redirected" | "unavailable"
  status       String
  questionsJson String  @db.Text
  checkedAt    DateTime

  @@index([boardToken, jobId])
}

/// Application Session: raggruppa candidature simili (stesso ruolo + settore)
/// per permettere pause/resume di intere "campagne". Ogni utente vede
/// le sessioni attive su /preferences.
model ApplicationSession {
  id        String   @id @default(cuid())
  userId    String
  /// (legacy) chiave canonica usata dal vecchio find-or-create. Tenuta
  /// per back-compat con sessioni create prima del refactor "round".
  key       String
  /// label human-readable mostrata in UI (es. "Round Product Designer")
  label     String
  /// Job title canonico del round (es. "Senior Product Designer").
  /// Null sulle sessioni legacy: il cron usa label come fallback.
  title     String?
  /// Quante candidature questo round vuole inviare prima di chiudersi.
  /// Default 30. Configurabile alla creazione.
  targetCount Int @default(30)
  /// Counter delle candidature consegnate (status=success). Aggiornato
  /// dal worker on-success.
  sentCount Int @default(0)
  /// Contesto/esperienza extra fornito dall'utente alla creazione del
  /// round. Iniettato in Claude nel cover letter / CV ottimizzazione
  /// per personalizzare il CV alle peculiarità di questo round.
  customContext String?
  /// Stato del round:
  ///   "active"     = il cron pesca job per questa sessione
  ///   "paused"     = stand-by, nessun nuovo invio
  ///   "completed"  = sentCount >= targetCount, pronto per chiedere
  ///                  all'utente se avviare un altro round
  ///   "cancelled"  = utente ha annullato manualmente
  ///   (legacy "auto" è equivalente ad "active")
  status    String   @default("active")
  /// True quando l'utente ha visto il prompt "round completato" sulla
  /// dashboard, così non riapparirà.
  completedAcknowledgedAt DateTime?
  createdAt DateTime @default(now())
  completedAt DateTime?
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([userId, key])
  @@index([userId, status])
}

model Application {
  id              String    @id @default(cuid())
  userId          String
  jobId           String
  portal          String
  status          String    @default("queued")
  errorMessage    String?
  atsScore        Int?
  suggestionsJson String?
  cvDocxPath      String?
  coverLetterPath String?
  coverLetterText String?  @db.Text
  cvPdfPath       String?
  cvLanguage      String?  // "it" | "en"
  sessionId       String?
  /// "portal_<id>" (greenhouse/lever/workable/...) | "email_recruiter" | "playwright_portal" | null
  submittedVia    String?
  /// Grado di conferma del submit dell'adapter ATS:
  ///   "DETECTED"    = thank-you page / URL di conferma rilevati (alta confidenza)
  ///   "UNCONFIRMED" = submit cliccato ma nessuna conferma chiara (verificare a mano)
  ///   "DRY_RUN"     = form compilato ma submit non eseguito (env flag)
  ///   null          = candidatura via fallback email, o pre-instrumentation
  /// Persistito dal worker a partire dal fix false-success (vedi changelog).
  submitConfirmation String?
  /// Compact verified ATS response evidence; never raw form/credential data.
  submissionReceiptJson String? @db.Text
  /// Explicit application-bound answers; never infer permission from global history.
  userProvidedAnswersJson String? @db.Text
  /// Server evidence for a candidate-confirmed continuation before any final submit. No legacy backfill.
  answerContinuationJson String? @db.Text
  /// Explicit user approval for a manual/hybrid application; no legacy backfill.
  consentGrantedAt DateTime?
  /// Canary debug snapshot: JSON con stato form pre-submit, screenshot
  /// URL Vercel Blob, HTTP response, post-submit URL/body excerpt.
  /// Popolato solo quando env CANARY_DEBUG=1 — diagnostica integrità
  /// del flow di submission reale. NON popolato in run normali.
  canaryLog       String?   @db.Text
  /// Numero di retry automatici già tentati per submit falliti transitori
  /// (session expired, ATS 5xx, network timeout). Cap a 1 retry per non
  /// intasare Anthropic budget su fallimenti sistemici.
  retryCount      Int       @default(0)
  // Stato impostato manualmente dall'utente (es. "vista", "colloquio", "offerta",
  // "rifiutata") quando ha info esterne (risposta via email, LinkedIn, ecc.).
  // Ortogonale a `status` che è lo stato del pipeline interno.
  userStatus      String?
  // Open-tracking pixel: unique token in the email/pixel URL. Quando il pixel
  // viene caricato (o Resend webhook notifica email.opened) marchiamo viewedAt.
  trackingToken   String?   @unique
  viewedAt        DateTime?
  // Risposte REALI del recruiter: quando un recruiter risponde all'email di
  // candidatura, la reply arriva all'indirizzo inbound per-application
  // (reply+<id>@inbound), Resend ce la inoltra via webhook email.received, la
  // classifichiamo (colloquio/rifiutata/risposta) e popoliamo questi campi.
  // Distinti da viewedAt (= solo apertura email, NON una risposta umana).
  lastReplyAt     DateTime?
  replyCount      Int       @default(0)
  /// Classificazione dell'ultima risposta: "colloquio" | "rifiutata" | "risposta"
  lastReplyKind   String?
  // Quando l'adapter incontra campi OBBLIGATORI che non sa rispondere dai
  // dati del candidato, la candidatura va in status="needs_answers" e qui
  // salviamo le domande (JSON array di { label, kind, options }). L'utente
  // le risponde in /questions, le salviamo in UserAnswer (riutilizzabili) e
  // ri-accodiamo la candidatura. Niente più invii bloccati in silenzio.
  pendingQuestionsJson String? @db.Text
  /// Risposte usate nel form per QUESTA candidatura (JSON array di
  /// { label, answer, source: "user"|"profile"|"rule"|"ai" }). Mostrate
  /// all'utente in /inbox così vede cosa è stato inviato a suo nome.
  answersUsedJson String? @db.Text
  /// Timestamp REALE dell'invio confermato (per contare giorni senza risposta).
  /// Popolato SOLO quando status=success E submitConfirmation=DETECTED*.
  /// Usato per UX onesta "Nessuna risposta dopo N giorni" (ghosting).
  submittedAt     DateTime?
  /// Proof-of-send (src/lib/proof-of-send.ts). Orthogonal to `status`:
  /// sendStatus=submitted is ONLY written together with a recorded proof
  /// (DB CHECK "Application_submitted_requires_proof"). Without proof the
  /// row is needs_user (verify by hand) or failed, with sendFailureReason.
  sendStatus        SendStatus     @default(not_sent)
  sendFailureReason String?
  sentProofType     SentProofType?
  /// Gmail message id / ATS receipt id / screenshot URL / provider message id / InboundEmail id.
  sentProofRef      String?
  sentAt            DateTime?
  /// Set when an ATS confirmation email ("abbiamo ricevuto la tua candidatura") is matched.
  confirmedAt       DateTime?
  /// Ultimo check status recruiter (per rate-limit check giornalieri).
  /// On unsent queued rows held for an unverifiable posting it records the
  /// FIRST liveness re-check (held-application-release.ts backoff bound).
  lastStatusCheckAt DateTime?
  /// One-time recruiter-email recheck for skip-list handoffs created before
  /// employer-domain discovery. Null = not yet attempted. Additive only.
  recruiterEmailRecheckedAt DateTime?
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  /// Random worker ownership token. Additive; null on historical rows.
  leaseToken      String?
  /// Exclusive claim ends at this instant. Recovery may reclaim only after it.
  leaseExpiresAt  DateTime?
  /// Written immediately before an irreversible submit. Never auto-retried.
  submitStartedAt DateTime?
  /// Playwright submit control invoked (evidence level 1). Null on historical rows.
  submitClickPerformedAt DateTime?
  /// Matched application-write POST observed in the click window (level 2).
  outboundSubmissionJson String? @db.Text
  /// Destination status/body/rejection/ambiguity when level 3 is not a verified receipt.
  destinationResponseJson String? @db.Text
  completedAt     DateTime?

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  job     Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  session ApplicationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  interviewSessions InterviewSession[]
  replies           ApplicationReply[]
  gmailMessages     GmailMessage[]
  emailAttempts     ApplicationEmailAttempt[]
  inboxReplies      InboxReply[]
  mailboxSends      MailboxSend[]
  inboundEmails     InboundEmail[]
  emailTestAttempts EmailTestAttempt[]

  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([userId, sendStatus])
  @@index([status, leaseExpiresAt])
}

/// Stato di invio verificabile. "submitted" richiede sempre una prova.
enum SendStatus {
  not_sent
  submitted
  needs_user
  failed
}

/// Tipo di prova che giustifica sendStatus=submitted.
enum SentProofType {
  /// Message id restituito da Gmail users.messages.send (casella utente).
  gmail_message_id
  /// Email di conferma dell'ATS ricevuta (InboundEmail / GmailMessage id).
  ats_confirmation_email
  /// Screenshot della pagina di successo (URL Blob).
  success_page_screenshot
  /// Ricevuta HTTP/DOM verificata dall'adapter ATS (submissionReceiptJson).
  ats_submission_receipt
  /// Id messaggio accettato da Resend / Microsoft Graph.
  email_provider_message_id
}

model ApplicationSubmissionReservation {
  id               String   @id @default(cuid())
  applicationId    String
  subjectKey       String
  attemptStartedAt DateTime
  channel          String
  rolloutStartedAt DateTime
  budgetDay        DateTime @db.Date
  reservedAt       DateTime @default(now())

  // Deliberately no cascading FK: deleting a customer/application must not
  // refund a possible external attempt or erase the day's safety budget.
  // Contains only an opaque application ID, channel and timing, never a CV.
  @@unique([applicationId, budgetDay])
  @@unique([subjectKey, budgetDay])
  @@index([budgetDay])
}

/// Risposta inbound a una candidatura inviata via email_recruiter.
/// Una riga per ogni email ricevuta dall'indirizzo reply+<appId>@inbound.
/// Conserviamo il contenuto per mostrarlo all'utente nella dashboard e per
/// trasparenza ("queste sono risposte VERE, non aperture email").
model ApplicationReply {
  id            String   @id @default(cuid())
  applicationId String
  /// Mittente reale (recruiter). Es. "Jane Doe <jane@acme.com>"
  fromAddress   String
  subject       String?
  /// Corpo testuale (preferito text/plain, fallback html→text). Troncato.
  bodyText      String?  @db.Text
  /// Classificazione automatica: "colloquio" | "rifiutata" | "risposta" |
  /// "auto" (out-of-office / no-reply) | "bounce" (mailer-daemon).
  kind          String
  /// true se è una risposta umana reale (non auto/bounce) → conta come "risposta".
  isHuman       Boolean  @default(true)
  receivedAt    DateTime @default(now())
  /// Null on historical rows: unread history must not be invented.
  attentionTrackedAt DateTime? @default(now())
  readAt        DateTime?
  handledAt     DateTime?
  remindAt      DateTime?
  /// Provider identity deduplicates redelivery independently of webhook event IDs.
  provider          String?
  providerMessageId String?
  providerEventId   String? @unique
  /// Validated threading metadata only; never expose raw headers to the client.
  rfcMessageId      String?
  replyToAddress    String?
  referencesHeader  String? @db.Text
  directRecipient   Boolean @default(false)
  outboundReplies   InboxReply[]
  isSecurityCode    Boolean @default(false)
  processingAppliedAt DateTime?
  /// Durable notification outbox. Message remains visible even if forwarding fails.
  forwardStatus         String @default("skipped")
  forwardPayloadJson    String? @db.Text
  forwardIdempotencyKey String? @unique
  forwardStartedAt      DateTime?
  forwardLeaseUntil     DateTime?
  forwardLeaseToken     String?
  forwardedAt           DateTime?
  forwardProviderId     String?
  forwardError          String?
  /// Mailbox notify outbox: pending | immediate_sent | digest_queued | digest_sent | skipped
  notifyStatus          String  @default("pending")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, receivedAt])
  @@unique([provider, providerMessageId])
  @@index([forwardStatus, forwardLeaseUntil])
}

/// One immutable recipient + idempotency key per external submission attempt.
/// Accepted means API acceptance, delivered means recipient-server delivery.
model ApplicationEmailAttempt {
  id              String @id @default(cuid())
  applicationId   String
  attemptKey      String @unique
  recipient       String
  recipientProvenanceJson String? @db.Text
  providerEmailId String? @unique
  status          String @default("sending")
  acceptedAt      DateTime?
  lastEventAt     DateTime?
  lastEventType   String?
  failureReason   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  events EmailProviderEvent[]

  @@index([applicationId, createdAt])
}

/// Provider event journal: survives duplicates, out-of-order delivery and events
/// that race API acceptance. Contains routing/status only, never message bodies.
model EmailProviderEvent {
  id              String @id @default(cuid())
  providerEventId String @unique
  providerEmailId String
  type            String
  occurredAt      DateTime
  attemptId       String?
  processedAt     DateTime?
  failureReason   String?
  createdAt       DateTime @default(now())

  attempt ApplicationEmailAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([providerEmailId, occurredAt])
}

/// Messaggio Gmail sincronizzato: email ricevute dall'account Gmail dell'utente,
/// filtrate per recruiter/job mail e classificate. Fonte: Gmail API via OAuth.
/// Permette di vedere risposte recruiter che arrivano all'email personale,
/// non solo quelle inviate via reply+ inbound.
model GmailMessage {
  id            String   @id @default(cuid())
  userId        String
  /// Gmail message ID (permanente, usato per dedup).
  gmailMessageId String
  /// Gmail thread ID.
  threadId      String?
  /// Mittente (from header).
  fromAddress   String
  /// Destinatario (to header).
  toAddress     String?
  subject       String?
  /// Snippet (~200 char preview fornito da Gmail API).
  snippet       String?
  /// Corpo testuale completo (text/plain preferito, fallback html→text).
  bodyText      String?  @db.Text
  /// Data di invio/ricezione del messaggio.
  date          DateTime
  /// Classificazione: "colloquio" | "rifiutata" | "risposta" | "ricevuta" | "auto" | "bounce".
  kind          String
  /// true se è una risposta umana reale.
  isHuman       Boolean  @default(true)
  /// Application collegata (quando riusciamo a matchare company/title/email).
  applicationId String?
  /// Label/category per filtri UI (popolato dalla classificazione kind).
  label         String?
  /// true se l'utente ha visualizzato il messaggio nella UI Inbox.
  read          Boolean  @default(false)
  handledAt     DateTime?
  remindAt      DateTime?
  /// true se l'utente ha archiviato/nascosto il messaggio.
  archived      Boolean  @default(false)
  syncedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@unique([userId, gmailMessageId])
  @@index([userId, date])
  @@index([userId, read])
  @@index([applicationId])
}

/// Sessione di preparazione + Copilot per un colloquio specifico.
/// Una per Application, ma teoricamente l'utente può rifarne una nuova
/// per round successivi (HR → technical → final). Per ora 1:1 con Application.
model InterviewSession {
  id            String   @id @default(cuid())
  applicationId String
  userId        String
  /// Brief generato dall'onboarding (JSON):
  ///   { goals, expectations, weakAreas, strengths, customNotes, generatedAt }
  briefJson     String?  @db.Text
  /// Pairing code univoco per linkare la Chrome extension a questa sessione
  /// (l'extension manda transcript chunks → web app via WebSocket/SSE).
  /// 8 char alfanumerico, generato al setup.
  pairingCode   String?  @unique
  pairingCodeExpiresAt DateTime?
  /// Live transcript accumulato durante la call. JSONL chunks:
  ///   { ts, speaker?, text, source: "extension" | "paste" | "dictation" }
  /// Mai persistito post-call se l'utente preme "Cancella tutto".
  transcriptJsonl String? @db.Text
  /// Storia delle interazioni col Copilot (domanda → risposta suggerita).
  /// JSONL: { ts, question, suggestion, model, latencyMs }
  copilotLogJsonl String? @db.Text
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([applicationId])
}

/// Log platform-wide di ogni email effettivamente consegnata via Resend.
/// Usato per stimare il consumo quota giornaliera/mensile e skippare
/// l'invio quando ci avviciniamo al limite (mantiene solo il conteggio,
/// no content / allegati / PII non necessarie).
model EmailLog {
  id        String   @id @default(cuid())
  kind      String   // "cv_ready" | "application_sent" | "signup_verify" | "password_reset" | "welcome" | "magic_link" | "other"
  to        String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
}

/// CV staged BEFORE user account exists (from /optimize public form).
/// When the user completes email magic-link, the signIn event adopts the row
/// into CVDocument + sets User.privacyConsentAt, then deletes the staging row.
model PendingCvSubmission {
  id                String   @id @default(cuid())
  email             String   @unique
  originalFilename  String
  storagePath       String
  extractedText     String
  privacyConsentAt  DateTime
  createdAt         DateTime @default(now())
  expiresAt         DateTime

  @@index([expiresAt])
}

model CVDocument {
  id                String   @id @default(cuid())
  userId            String
  originalFilename  String
  storagePath       String
  extractedText     String
  parsedProfileJson String?  // Cached AI extraction (name, seniority, years, english, ...)
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Azioni dell'utente sull'abbonamento dalle Impostazioni (pausa, cancellazione,
/// sconto accettato) con il motivo dichiarato: serve per capire il churn.
model SubscriptionEvent {
  id          String   @id @default(cuid())
  userId      String
  /// "cancel" | "pause" | "resume" | "undo_cancel" | "discount_accepted" | "review_clicked"
  action      String
  /// "too_expensive" | "found_job" | "not_useful" | "technical" | "other" | null
  reason      String?
  /// Per found_job: l'utente dichiara di aver trovato lavoro grazie a LavorAI.
  foundViaUs  Boolean?
  comment     String?  @db.Text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

/// Deliberate user replies only. Never drained by cron or application workers.
model InboxReply {
  id String @id
  applicationId String
  parentReplyId String
  bodyText String @db.Text
  recipient String
  subject String
  fromAddress String
  replyToAddress String
  inReplyTo String
  referencesHeader String @db.Text
  status String @default("draft")
  providerEmailId String? @unique
  failureCode String?
  firstAttemptAt DateTime?
  leaseUntil DateTime?
  leaseToken String?
  acceptedAt DateTime?
  lastEventAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  parentReply ApplicationReply @relation(fields: [parentReplyId], references: [id], onDelete: Cascade)
  @@index([applicationId, createdAt])
  @@index([parentReplyId])
}

/// Explicit, reversible listing exclusions. Never changes profile/preferences.
model JobDismissal {
  userId String
  jobId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@id([userId, jobId])
}

/// One row per AI provider call (token usage as reported by the provider).
/// Additive table, no FK on purpose: no CV/prompt content, no user id; the
/// optional applicationId links cost to an application while it exists.
/// Cost is NOT stored: it is estimated at read time from AI_PRICING_USD_PER_MTOK.
model AiUsageEvent {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  task              String
  provider          String
  model             String
  inputTokens       Int?
  outputTokens      Int?
  cachedInputTokens Int?
  applicationId     String?

  @@index([createdAt])
  @@index([applicationId])
}

/// Casella email DELL'UTENTE collegata per inviare candidature a suo nome
/// (Gmail API gmail.send / Microsoft Graph Mail.Send). Token cifrati AES-GCM
/// (src/lib/crypto.ts). Separata da Account (login Google, sola lettura).
model MailboxConnection {
  id               String    @id @default(cuid())
  userId           String
  /// "gmail" | "outlook"
  provider         String
  email            String
  accessTokenEnc   String    @db.Text
  refreshTokenEnc  String?   @db.Text
  expiresAt        DateTime?
  scopes           String
  /// "active" | "revoked" | "error"
  status           String    @default("active")
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

/// Un invio di candidatura dalla casella dell'utente. Stati (vedi
/// src/lib/mailbox/delivery-state.ts): prepared → approved → submitted →
/// delivery_confirmed | failed; "unverified" se l'esito non è determinabile.
/// Mai "delivery_confirmed" senza evidenza (id provider + nessun rimbalzo
/// rilevato nel thread dopo la finestra di osservazione).
model MailboxSend {
  id                String    @id @default(cuid())
  applicationId     String
  userId            String
  provider          String
  fromAddress       String
  recipient         String
  /// Provenienza del destinatario (JSON compatto, mai il corpo della pagina).
  recipientProvenanceJson String? @db.Text
  subject           String
  bodyText          String    @db.Text
  attachmentsJson   String    @db.Text
  state             String    @default("prepared")
  approvedAt        DateTime?
  /// Claim anti-doppio-invio: valorizzato atomicamente prima della chiamata al provider.
  sendClaimedAt     DateTime?
  submittedAt       DateTime?
  providerMessageId String?
  providerThreadId  String?
  internetMessageId String?
  /// true = invio simulato (non-production o guardia attiva): nessuna email reale.
  dryRun            Boolean   @default(false)
  lastCheckedAt     DateTime?
  checkCount        Int       @default(0)
  confirmedAt       DateTime?
  failedAt          DateTime?
  failureReason     String?
  /// Evidenza compatta del rimbalzo (mittente/oggetto del DSN), mai il corpo.
  bounceEvidenceJson String?  @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([userId, state])
  @@index([state, submittedAt])
}

/// Indirizzo LavorAI per-utente (es. mario.rossi.k3f9@apply.lavorai.it), creato
/// on demand. Usato come email candidato nei form ATS: conferme, OTP e
/// risposte arrivano a /api/inbound/email.
model UserInbox {
  id         String    @id @default(cuid())
  userId     String    @unique
  /// Local part (lowercase, [a-z0-9.]).
  slug       String    @unique
  /// slug@domain, lowercase.
  address    String    @unique
  domain     String
  disabledAt DateTime?
  createdAt  DateTime  @default(now())

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails InboundEmail[]
}

enum InboundEmailCategory {
  confirmation
  incomplete
  interview
  rejection
  other
}

/// Email ricevuta su un UserInbox. Contenuto troncato; mai inoltrato da qui.
model InboundEmail {
  id                String               @id @default(cuid())
  inboxId           String
  userId            String
  provider          String
  providerMessageId String
  rfcMessageId      String?
  fromAddress       String
  toAddress         String
  subject           String?
  bodyText          String?              @db.Text
  receivedAt        DateTime
  category          InboundEmailCategory @default(other)
  /// "rules" | "ai"
  classifiedBy      String               @default("rules")
  /// Codici OTP / verifica estratti (JSON array di stringhe).
  codesJson         String               @default("[]")
  /// Link estratti (JSON array di { url, kind: "verification" | "other" }).
  linksJson         String               @default("[]") @db.Text
  applicationId     String?
  matchedAt         DateTime?
  /// Richer mailbox kind (confirmation|otp|interview|rejection|auto_reply|redirected_to_portal|recruiter_question|other).
  mailboxKind       String?
  /// pending | immediate_sent | digest_queued | digest_sent | skipped
  notifyStatus      String               @default("pending")
  createdAt         DateTime             @default(now())

  inbox       UserInbox    @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@unique([provider, providerMessageId])
  @@index([userId, receivedAt])
  @@index([applicationId])
}

/// Shared first-activation budget. Concurrent Vercel and GitHub Actions
/// drains increment usedCount with WHERE usedCount < maxCount. Not process memory.
model ApplicationReleaseBatch {
  id        String   @id
  maxCount  Int
  usedCount Int      @default(0)
  createdAt DateTime @default(now())
  grants    ApplicationReleaseGrant[]
}

/// One grant per application id. Unique so an id is never released twice.
model ApplicationReleaseGrant {
  applicationId String   @id
  batchId       String
  releasedAt    DateTime @default(now())
  batch         ApplicationReleaseBatch @relation(fields: [batchId], references: [id])

  @@index([batchId])
}

/// One-time controlled email test. Unique per (runKey, destination).
/// Never reuses the 14/10 canary attempt key.
model EmailTestAttempt {
  id            String   @id @default(cuid())
  runKey        String
  destination   String
  attemptKey      String   @unique
  applicationId   String
  providerResult  String?
  createdAt       DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([runKey, destination])
  @@index([applicationId])
}
