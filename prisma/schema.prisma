// LavorAI — production schema.
//
// PER LA MIGRAZIONE A POSTGRES (prod Supabase):
//   1. Cambia provider da "sqlite" a "postgresql" sotto
//   2. Imposta DATABASE_URL alla connection string Supabase (pooled)
//   3. npx prisma migrate reset  (cancella le migrazioni SQLite)
//   4. npx prisma migrate dev --name initial_postgres
//   5. Commit migrations/ aggiornate
//   6. In prod (Vercel): npx prisma migrate deploy durante il build
//
// Le migrations SQLite attuali contengono SQL-lite-specific e NON
// funzionano su Postgres. Serve un reset pulito.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Provider postgresql per produzione (Vercel Postgres / Supabase / Neon).
  // Vercel Postgres best practice:
  //   DATABASE_URL → POSTGRES_PRISMA_URL (pooled, per runtime queries)
  //   DIRECT_URL   → POSTGRES_URL_NON_POOLING (diretta, per migrations/db push)
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- NextAuth tables (@auth/prisma-adapter) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Token one-time per verificare l'email post-signup password.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique  // sha256 hex
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Token one-time per il reset password. Separato da VerificationToken
/// (che NextAuth riserva al magic link) per evitare collisioni.
model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique  // sha256 hex
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------- Business tables ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())

  // Subscription (one-to-one con Stripe)
  tier                   String    @default("free") // "free" | "pro" | "pro_plus"
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  subscriptionStatus     String?   // "active" | "canceled" | "past_due" | null
  currentPeriodEnd       DateTime?

  // Onboarding / lifecycle
  welcomeSeenAt    DateTime?
  onboardedAt      DateTime?
  lastLoginAt      DateTime?
  privacyConsentAt DateTime?

  // Dati per auto-apply targeting
  seniority        String?  // "junior" | "mid" | "senior" | "lead" | "principal"
  yearsExperience  Int?
  englishLevel     String?  // "none" | "a2" | "b1" | "b2" | "c1" | "c2"
  italianNative    Boolean  @default(true)
  euAuthorized     Boolean  @default(true)
  noticePeriod     String?  // "immediate" | "1m" | "2m" | "3m_plus"
  avoidCompanies   String?  // comma-separated lowercase

  // UI language preference. "it" o "en". Settato al primo signup dal
  // cookie NEXT_LOCALE (impostato dal proxy geo-detect). Usato per:
  //  - Email transazionali (verifica, CV pronto, conferma candidatura)
  //  - Eventuale routing futuro nelle preferenze
  locale           String   @default("it")

  accounts       Account[]
  sessions       Session[]
  portalSessions PortalSession[]
  applications   Application[]
  cvDocuments    CVDocument[]
  preferences         UserPreferences?
  cvProfile           CVProfile?
  applicationSessions ApplicationSession[]
  interviewSessions   InterviewSession[]
  resetTokens    PasswordResetToken[]
  verifyTokens   EmailVerificationToken[]
  popupResponses PopupResponse[]
  answers        UserAnswer[]
}

/// Risposte RIUTILIZZABILI dell'utente alle domande dei form di candidatura
/// (es. "Hai diritto al lavoro in UK?", "Hai esperienza con app mobile?",
/// "Link al portfolio"). Chieste UNA volta: la prossima volta che un form
/// pone la stessa domanda, la riempiamo da qui senza ridisturbare l'utente.
/// labelKey = label normalizzata (lowercase, no spazi/punteggiatura) per il
/// match cross-job.
model UserAnswer {
  id         String   @id @default(cuid())
  userId     String
  /// Chiave normalizzata della domanda (per match tra job diversi).
  labelKey   String
  /// Testo originale della domanda (per mostrarla all'utente).
  label      String
  /// "text" | "textarea" | "select" | "react-select" | "checkbox"
  kind       String   @default("text")
  /// Opzioni disponibili (per select/react-select), JSON array di stringhe.
  optionsJson String? @db.Text
  /// Risposta dell'utente. null/"" = ancora da rispondere (pending).
  answer     String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  answeredAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, labelKey])
  @@index([userId, answeredAt])
}

/// Popup/sondaggio creato dall'admin (founder) e mostrato agli utenti
/// dentro l'app. Es: "Ti piace la piattaforma?", richieste di feedback,
/// proposte di miglioramento. Gestiti da /admin.
model AdminPopup {
  id        String  @id @default(cuid())
  title     String
  body      String  @db.Text
  /// Tipo di interazione richiesta:
  ///   "rating"      = stelline 1-5 (+ commento opzionale)
  ///   "feedback"    = campo testo libero
  ///   "improvement" = proposta di miglioramento (campo testo)
  ///   "info"        = solo messaggio, bottone di conferma (nessun input)
  kind      String  @default("feedback")
  /// Etichetta del bottone di invio/conferma. Default per-kind se vuoto.
  ctaLabel  String?
  /// Pubblico target: "all" | "free" | "pro" | "pro_plus".
  audience  String  @default("all")
  /// Solo i popup attivi vengono mostrati. Disattivare = stop immediato.
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  /// Scadenza opzionale: dopo questa data non viene più mostrato.
  expiresAt DateTime?

  responses PopupResponse[]

  @@index([active])
}

/// Risposta (o dismiss) di un utente a un AdminPopup. Una per (popup,user):
/// così ogni utente vede il popup una volta sola, poi non più.
model PopupResponse {
  id        String  @id @default(cuid())
  popupId   String
  userId    String
  /// Valutazione 1-5 per i popup "rating". null altrimenti.
  rating    Int?
  /// Testo libero per "feedback"/"improvement" (o commento del rating).
  text      String? @db.Text
  /// true se l'utente ha chiuso senza rispondere ("Più tardi"/X).
  dismissed Boolean @default(false)
  createdAt DateTime @default(now())

  popup AdminPopup @relation(fields: [popupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([popupId, userId])
  @@index([popupId, createdAt])
}

model UserPreferences {
  id          String @id @default(cuid())
  userId      String @unique
  // Deprecated legacy flag — autoApplyMode è l'autorità
  autoApplyOn Boolean @default(false)
  // "off" (nessuna candidatura), "hybrid" (richiede conferma utente per singola), "auto" (candida direttamente)
  autoApplyMode String @default("hybrid")
  dailyCap    Int    @default(25)
  matchMin    Int    @default(50)
  salaryMin   Int    @default(30)
  // "employee" | "piva" | "both" — filtra le candidature per tipo
  // contrattuale. "piva" = cerchiamo solo incarichi freelance /
  // contract / partnership (P.IVA italiana). "both" = sia dipendente
  // sia freelance.
  employmentType String @default("employee")
  // Campi P.IVA — usati per generare un pitch B2B quando si candida
  // a progetti freelance/contract. Tutti opzionali: se mancano, Claude
  // genera comunque un pitch onesto ma meno puntuale.
  dailyRate      Int?       // tariffa giornaliera in euro (es. 450)
  availableFrom  String?    // stringa libera: "immediate" | "2 settimane" | "2026-06-01"
  vatNumber      String?    // partita IVA (opzionale, per firma professionale)
  portfolioUrl   String?    // link portfolio / sito / LinkedIn
  // Risposte standard alle domande tipiche dei form ATS — il worker
  // legge questo blob e lo inietta nei custom field di Greenhouse/Lever
  // (work auth, salary, notice period, LinkedIn, EEO, ecc).
  // Schema atteso (vedi src/lib/application-answers.ts):
  //   { workAuthEU, salaryExpectationEur, relocate, linkedinUrl,
  //     githubUrl, howHeard, whyInterested, noticePeriod,
  //     eeoGender, eeoVeteran, eeoDisability }
  applicationAnswersJson String @default("{}")
  rolesJson   String @default("[]")
  locationsJson String @default("[]")
  sourcesJson String @default("[]")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Structured CV profile — single source of truth for CV builder.
/// All sections are JSON blobs to keep schema small; shapes validated in code.
model CVProfile {
  id             String   @id @default(cuid())
  userId         String   @unique

  // Personal
  firstName      String   @default("")
  lastName       String   @default("")
  email          String   @default("")
  phone          String   @default("")
  city           String   @default("")
  title          String   @default("")   // professional headline
  summary        String   @default("") @db.Text

  // Sections (JSON array strings)
  experiencesJson String  @default("[]") @db.Text
  educationJson   String  @default("[]") @db.Text
  skillsJson      String  @default("[]") @db.Text
  languagesJson   String  @default("[]") @db.Text
  linksJson       String  @default("[]") @db.Text

  // Base CV PDF (not job-specific)
  pdfPath        String?
  pdfLanguage    String?  // "it" | "en" | null

  // Foto profilo CV (opzionale)
  photoPath      String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PortalSession {
  id               String    @id @default(cuid())
  userId           String
  portal           String
  encryptedCookies String
  userAgent        String
  lastValidatedAt  DateTime  @default(now())
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, portal])
}

model Job {
  id            String    @id @default(cuid())
  externalId    String
  source        String
  title         String
  company       String?
  location      String?
  description   String
  url           String
  contractType  String?
  remote        Boolean   @default(false)
  salaryMin     Int?
  salaryMax     Int?
  category      String?
  postedAt      DateTime?
  cachedAt      DateTime  @default(now())
  // Email del recruiter estratta scrapando il job.url. Null se non trovata.
  recruiterEmail String?
  recruiterScrapedAt DateTime?
  // Slug dell'ATS (es. "stripe" per boards.greenhouse.io/stripe/...)
  // Usato per costruire l'URL canonico del form quando il job è linkato
  // da una career page custom (es. stripe.com/jobs?gh_jid=...)
  sourceSlug String?

  applications Application[]

  @@unique([externalId, source])
}

/// Application Session: raggruppa candidature simili (stesso ruolo + settore)
/// per permettere pause/resume di intere "campagne". Ogni utente vede
/// le sessioni attive su /preferences.
model ApplicationSession {
  id        String   @id @default(cuid())
  userId    String
  /// (legacy) chiave canonica usata dal vecchio find-or-create. Tenuta
  /// per back-compat con sessioni create prima del refactor "round".
  key       String
  /// label human-readable mostrata in UI (es. "Round Product Designer")
  label     String
  /// Job title canonico del round (es. "Senior Product Designer").
  /// Null sulle sessioni legacy: il cron usa label come fallback.
  title     String?
  /// Quante candidature questo round vuole inviare prima di chiudersi.
  /// Default 30. Configurabile alla creazione.
  targetCount Int @default(30)
  /// Counter delle candidature consegnate (status=success). Aggiornato
  /// dal worker on-success.
  sentCount Int @default(0)
  /// Contesto/esperienza extra fornito dall'utente alla creazione del
  /// round. Iniettato in Claude nel cover letter / CV ottimizzazione
  /// per personalizzare il CV alle peculiarità di questo round.
  customContext String?
  /// Stato del round:
  ///   "active"     = il cron pesca job per questa sessione
  ///   "paused"     = stand-by, nessun nuovo invio
  ///   "completed"  = sentCount >= targetCount, pronto per chiedere
  ///                  all'utente se avviare un altro round
  ///   "cancelled"  = utente ha annullato manualmente
  ///   (legacy "auto" è equivalente ad "active")
  status    String   @default("active")
  /// True quando l'utente ha visto il prompt "round completato" sulla
  /// dashboard, così non riapparirà.
  completedAcknowledgedAt DateTime?
  createdAt DateTime @default(now())
  completedAt DateTime?
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([userId, key])
  @@index([userId, status])
}

model Application {
  id              String    @id @default(cuid())
  userId          String
  jobId           String
  portal          String
  status          String    @default("queued")
  errorMessage    String?
  atsScore        Int?
  suggestionsJson String?
  cvDocxPath      String?
  coverLetterPath String?
  coverLetterText String?  @db.Text
  cvPdfPath       String?
  cvLanguage      String?  // "it" | "en"
  sessionId       String?
  /// "portal_<id>" (greenhouse/lever/workable/...) | "email_recruiter" | "playwright_portal" | null
  submittedVia    String?
  /// Grado di conferma del submit dell'adapter ATS:
  ///   "DETECTED"    = thank-you page / URL di conferma rilevati (alta confidenza)
  ///   "UNCONFIRMED" = submit cliccato ma nessuna conferma chiara (verificare a mano)
  ///   "DRY_RUN"     = form compilato ma submit non eseguito (env flag)
  ///   null          = candidatura via fallback email, o pre-instrumentation
  /// Persistito dal worker a partire dal fix false-success (vedi changelog).
  submitConfirmation String?
  /// Canary debug snapshot: JSON con stato form pre-submit, screenshot
  /// URL Vercel Blob, HTTP response, post-submit URL/body excerpt.
  /// Popolato solo quando env CANARY_DEBUG=1 — diagnostica integrità
  /// del flow di submission reale. NON popolato in run normali.
  canaryLog       String?   @db.Text
  // Stato impostato manualmente dall'utente (es. "vista", "colloquio", "offerta",
  // "rifiutata") quando ha info esterne (risposta via email, LinkedIn, ecc.).
  // Ortogonale a `status` che è lo stato del pipeline interno.
  userStatus      String?
  // Open-tracking pixel: unique token in the email/pixel URL. Quando il pixel
  // viene caricato (o Resend webhook notifica email.opened) marchiamo viewedAt.
  trackingToken   String?   @unique
  viewedAt        DateTime?
  // Risposte REALI del recruiter: quando un recruiter risponde all'email di
  // candidatura, la reply arriva all'indirizzo inbound per-application
  // (reply+<id>@inbound), Resend ce la inoltra via webhook email.received, la
  // classifichiamo (colloquio/rifiutata/risposta) e popoliamo questi campi.
  // Distinti da viewedAt (= solo apertura email, NON una risposta umana).
  lastReplyAt     DateTime?
  replyCount      Int       @default(0)
  /// Classificazione dell'ultima risposta: "colloquio" | "rifiutata" | "risposta"
  lastReplyKind   String?
  // Quando l'adapter incontra campi OBBLIGATORI che non sa rispondere dai
  // dati del candidato, la candidatura va in status="needs_answers" e qui
  // salviamo le domande (JSON array di { label, kind, options }). L'utente
  // le risponde in /questions, le salviamo in UserAnswer (riutilizzabili) e
  // ri-accodiamo la candidatura. Niente più invii bloccati in silenzio.
  pendingQuestionsJson String? @db.Text
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  job     Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  session ApplicationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  interviewSessions InterviewSession[]
  replies           ApplicationReply[]

  @@index([userId, createdAt])
  @@index([sessionId])
}

/// Risposta inbound a una candidatura inviata via email_recruiter.
/// Una riga per ogni email ricevuta dall'indirizzo reply+<appId>@inbound.
/// Conserviamo il contenuto per mostrarlo all'utente nella dashboard e per
/// trasparenza ("queste sono risposte VERE, non aperture email").
model ApplicationReply {
  id            String   @id @default(cuid())
  applicationId String
  /// Mittente reale (recruiter). Es. "Jane Doe <jane@acme.com>"
  fromAddress   String
  subject       String?
  /// Corpo testuale (preferito text/plain, fallback html→text). Troncato.
  bodyText      String?  @db.Text
  /// Classificazione automatica: "colloquio" | "rifiutata" | "risposta" |
  /// "auto" (out-of-office / no-reply) | "bounce" (mailer-daemon).
  kind          String
  /// true se è una risposta umana reale (non auto/bounce) → conta come "risposta".
  isHuman       Boolean  @default(true)
  receivedAt    DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, receivedAt])
}

/// Sessione di preparazione + Copilot per un colloquio specifico.
/// Una per Application, ma teoricamente l'utente può rifarne una nuova
/// per round successivi (HR → technical → final). Per ora 1:1 con Application.
model InterviewSession {
  id            String   @id @default(cuid())
  applicationId String
  userId        String
  /// Brief generato dall'onboarding (JSON):
  ///   { goals, expectations, weakAreas, strengths, customNotes, generatedAt }
  briefJson     String?  @db.Text
  /// Pairing code univoco per linkare la Chrome extension a questa sessione
  /// (l'extension manda transcript chunks → web app via WebSocket/SSE).
  /// 8 char alfanumerico, generato al setup.
  pairingCode   String?  @unique
  pairingCodeExpiresAt DateTime?
  /// Live transcript accumulato durante la call. JSONL chunks:
  ///   { ts, speaker?, text, source: "extension" | "paste" | "dictation" }
  /// Mai persistito post-call se l'utente preme "Cancella tutto".
  transcriptJsonl String? @db.Text
  /// Storia delle interazioni col Copilot (domanda → risposta suggerita).
  /// JSONL: { ts, question, suggestion, model, latencyMs }
  copilotLogJsonl String? @db.Text
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([applicationId])
}

/// Log platform-wide di ogni email effettivamente consegnata via Resend.
/// Usato per stimare il consumo quota giornaliera/mensile e skippare
/// l'invio quando ci avviciniamo al limite (mantiene solo il conteggio,
/// no content / allegati / PII non necessarie).
model EmailLog {
  id        String   @id @default(cuid())
  kind      String   // "cv_ready" | "application_sent" | "signup_verify" | "password_reset" | "welcome" | "magic_link" | "other"
  to        String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
}

/// CV staged BEFORE user account exists (from /optimize public form).
/// When the user completes email magic-link, the signIn event adopts the row
/// into CVDocument + sets User.privacyConsentAt, then deletes the staging row.
model PendingCvSubmission {
  id                String   @id @default(cuid())
  email             String   @unique
  originalFilename  String
  storagePath       String
  extractedText     String
  privacyConsentAt  DateTime
  createdAt         DateTime @default(now())
  expiresAt         DateTime

  @@index([expiresAt])
}

model CVDocument {
  id                String   @id @default(cuid())
  userId            String
  originalFilename  String
  storagePath       String
  extractedText     String
  parsedProfileJson String?  // Cached AI extraction (name, seniority, years, english, ...)
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
